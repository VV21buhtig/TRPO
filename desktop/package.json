{
  "name": "fastfood-desktop",
  "productName": "FastFood Operator",
  "version": "1.0.0",
  "description": "Рабочее место оператора «Онлайн-заказ» (Electron + TypeScript)",
  "main": "dist/main.js",
  "type": "commonjs",
  "author": "TRPO",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json",
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron ."
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "electron@45.2.1": true,
    "esbuild@0.28.2": true
  }
}
